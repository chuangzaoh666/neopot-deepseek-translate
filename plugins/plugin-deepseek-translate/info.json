{
  "plugin_type": "translate",
  "name": "plugin-deepseek-translate",
  "display": "DeepSeek 翻译",
  "version": "0.3.1",
  "author": "chuangzaoh666",
  "description": "使用 DeepSeek 官方 OpenAI 兼容接口进行翻译，只输出译文。模型固定为 deepseek-flash。",
  "icon": "icon.svg",
  "homepage": "https://api-docs.deepseek.com/guides/thinking_mode/",
  "language": {
    "auto": "Auto",
    "zh_cn": "Simplified Chinese",
    "zh_tw": "Traditional Chinese",
    "yue": "Cantonese",
    "ja": "Japanese",
    "en": "English",
    "ko": "Korean",
    "fr": "French",
    "es": "Spanish",
    "ru": "Russian",
    "de": "German",
    "it": "Italian",
    "tr": "Turkish",
    "pt_pt": "Portuguese",
    "pt_br": "Brazilian Portuguese",
    "vi": "Vietnamese",
    "id": "Indonesian",
    "th": "Thai",
    "ms": "Malay",
    "ar": "Arabic",
    "hi": "Hindi",
    "km": "Khmer",
    "fa": "Persian",
    "sv": "Swedish",
    "pl": "Polish",
    "nl": "Dutch",
    "uk": "Ukrainian",
    "he": "Hebrew"
  },
  "needs": [
    {
      "key": "apiKey",
      "display": "API 密钥",
      "type": "input"
    }
  ],
  "options": [
    {
      "key": "baseUrl",
      "display": "接口地址",
      "type": "input",
      "default": "https://api.deepseek.com/chat/completions"
    },
    {
      "key": "thinking",
      "display": "思考模式",
      "type": "select",
      "default": "enabled",
      "options": {
        "default": "默认",
        "enabled": "开启",
        "disabled": "关闭"
      }
    },
    {
      "key": "reasoningEffort",
      "display": "推理强度",
      "type": "select",
      "default": "default",
      "options": {
        "default": "默认",
        "low": "低",
        "high": "高",
        "max": "最高"
      }
    }
  ],
  "hotkeys": [
    {
      "key": "open_homepage",
      "display": "打开主页",
      "default": "",
      "handler": "openHomepage"
    }
  ]
}
